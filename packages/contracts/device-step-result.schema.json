{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aishop.device-step-result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "lease_id", "step_id", "status", "code", "message", "observed", "evidence_ids", "completed_at"],
  "properties": {
    "job_id": {"type": "string", "minLength": 1},
    "lease_id": {"type": "string", "minLength": 1},
    "step_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["SUCCEEDED", "RETRYABLE", "HUMAN_TAKEOVER", "FAILED"]},
    "code": {"type": "string", "minLength": 1, "maxLength": 80},
    "message": {"type": "string", "maxLength": 500},
    "observed": {"type": "object"},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "completed_at": {"type": "string", "format": "date-time"}
  }
}
