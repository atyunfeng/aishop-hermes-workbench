{
  "id": "qian-niu",
  "name": "千牛客服",
  "version": "1.0.0",
  "package_aliases": ["com.taobao.qianniu"],
  "supported_app_versions": {"com.taobao.qianniu": {"min": "0", "max": null}},
  "fixture_version": 1,
  "page_markers": {"conversation": {"description_any": ["输入消息"]}},
  "required_capabilities": ["accessibility"],
  "workflows": {
    "customer_reply": {
      "description": "向白名单测试客户回复咨询并采集发送回执",
      "risk_action": "reply",
      "required_inputs": ["package_name", "customer_name", "reply_text"],
      "steps": [
        {"id": "launch", "action": "LAUNCH_APP", "arguments": {"package_name": "{{package_name}}"}, "timeout_seconds": 15, "evidence_required": false},
        {"id": "open_customer", "action": "TAP_NODE", "arguments": {"text_any": ["{{customer_name}}"], "require_clickable": true}, "timeout_seconds": 15, "evidence_required": false},
        {"id": "write_reply", "action": "SET_TEXT", "arguments": {"description_any": ["输入消息"], "text": "{{reply_text}}"}, "timeout_seconds": 15, "evidence_required": false},
        {"id": "send", "action": "TAP_NODE", "arguments": {"text_any": ["发送"], "require_clickable": true}, "timeout_seconds": 15, "evidence_required": false},
        {"id": "verify", "action": "VERIFY_NODE", "arguments": {"text_any": ["{{reply_text}}"]}, "timeout_seconds": 15, "evidence_required": true},
        {"id": "evidence", "action": "CAPTURE_SCREEN", "arguments": {"label": "千牛客服发送回执"}, "timeout_seconds": 15, "evidence_required": true}
      ]
    }
  }
}
